{
  "name": "tracebug",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:dingtalk": "tsx tools/test-dingtalk-notification.ts",
    "test:dingtalk-outbox": "tsx tools/test-dingtalk-outbox.ts",
    "verify:dingtalk-schema": "tsx tools/verify-dingtalk-schema.ts",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "lucide-react": "latest",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "pinyin-pro": "^3.29.3",
    "react": "latest",
    "react-dom": "latest",
    "sanitize-html": "^2.17.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "latest",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "latest",
    "vite": "latest"
  }
}
